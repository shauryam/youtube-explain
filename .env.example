# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
# Leave YTEXPLAIN_MODEL out and the first interactive run asks which model to use,
# then writes your answer here. Set it yourself to skip that question.
# YTEXPLAIN_MODEL=z-ai/glm-5.2
YTEXPLAIN_OUTPUT_DIR=out
YTEXPLAIN_CACHE_DIR=.cache

# Web UI only. Without a password the server is open, which is fine on localhost
# and not fine anywhere else. The hourly limit caps how many runs a shared
# password can start; it is counted in memory and resets when the server does.
# YTEXPLAIN_WEB_PASSWORD=
# YTEXPLAIN_WEB_MAX_JOBS_PER_HOUR=10

# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
# Leave YTEXPLAIN_MODEL out and the first interactive run asks which model to use,
# then writes your answer here. Set it yourself to skip that question.
# YTEXPLAIN_MODEL=z-ai/glm-5.2
YTEXPLAIN_OUTPUT_DIR=out
YTEXPLAIN_CACHE_DIR=.cache
